generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tienda {
  nit                    String           @id
  nombre                 String
  activa                 Boolean          @default(true)
  inventarioHabilitado   Boolean          @default(true) @map("inventario_habilitado")
  inventarioInicializadoEn DateTime?      @map("inventario_inicializado_en")
  dependientes           Dependiente[]
  asignacionesAsesor     AsesorTienda[]
  inventarios            Inventario[]

  @@map("tiendas")
}

model Dependiente {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre           String
  nitTienda        String    @map("nit_tienda")
  codigoAcceso     String    @unique @map("codigo_acceso")
  pinHash          String    @map("pin_hash")
  fechaRegistro    DateTime  @default(now()) @map("fecha_registro")
  cedula           String?
  telefono         String?
  correo           String?
  ciudad           String?
  fechaNacimiento  DateTime? @map("fecha_nacimiento") @db.Date
  genero           String?
  tienda           Tienda    @relation(fields: [nitTienda], references: [nit])
  ventas           Venta[]

  @@map("dependientes")
}

model Marca {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre    String
  imagenUrl String?    @map("imagen_url")
  orden     Int        @default(0)
  productos Producto[]

  @@map("marcas")
}

model Producto {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo          String? @unique
  nombre          String
  marcaId         String  @map("marca_id") @db.Uuid
  modoDeUso       String? @map("modo_de_uso")
  imagenUrl       String? @map("imagen_url")
  puntosPorVenta  Int     @default(10) @map("puntos_por_venta")
  codigoBarras    String? @map("codigo_barras")
  precio          Int?    @map("precio")
  marca           Marca   @relation(fields: [marcaId], references: [id])
  ventas          Venta[]
  inventarios     InventarioDetalle[]

  @@map("productos")
}

model Asesor {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String
  usuario         String           @unique
  pinHash         String           @map("pin_hash")
  activo          Boolean          @default(true)
  fechaRegistro   DateTime         @default(now()) @map("fecha_registro")
  asignaciones    AsesorTienda[]
  inventarios     Inventario[]

  @@map("asesores")
}

model Administrador {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre          String
  usuario         String   @unique
  pinHash         String   @map("pin_hash")
  activo          Boolean  @default(true)
  fechaRegistro   DateTime @default(now()) @map("fecha_registro")

  @@map("administradores")
}

model AsesorTienda {
  asesorId        String   @map("asesor_id") @db.Uuid
  nitTienda       String   @map("nit_tienda")
  asignadoEn      DateTime @default(now()) @map("asignado_en")
  asesor          Asesor   @relation(fields: [asesorId], references: [id], onDelete: Cascade)
  tienda          Tienda   @relation(fields: [nitTienda], references: [nit], onDelete: Cascade)

  @@id([asesorId, nitTienda])
  @@map("asesores_tiendas")
}

model Inventario {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nitTienda       String              @map("nit_tienda")
  asesorId        String              @map("asesor_id") @db.Uuid
  fecha           DateTime            @default(now())
  observacion     String?
  tienda          Tienda              @relation(fields: [nitTienda], references: [nit], onDelete: Restrict)
  asesor          Asesor              @relation(fields: [asesorId], references: [id], onDelete: Restrict)
  detalles        InventarioDetalle[]

  @@index([nitTienda, fecha])
  @@map("inventarios")
}

model InventarioDetalle {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventarioId    String     @map("inventario_id") @db.Uuid
  productoId      String     @map("producto_id") @db.Uuid
  cantidad        Int
  inventario      Inventario @relation(fields: [inventarioId], references: [id], onDelete: Cascade)
  producto        Producto   @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([inventarioId, productoId])
  @@map("inventario_detalles")
}

model Venta {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dependienteId     String      @map("dependiente_id") @db.Uuid
  productoId        String      @map("producto_id") @db.Uuid
  cantidad          Int         @default(1)
  puntosGanados     Int         @map("puntos_ganados")
  fecha             DateTime    @default(now())
  estado            String      @default("pendiente")
  fechaAutorizacion DateTime?   @map("fecha_autorizacion")
  fechaVencimiento  DateTime?   @map("fecha_vencimiento")
  dependiente       Dependiente @relation(fields: [dependienteId], references: [id])
  producto          Producto    @relation(fields: [productoId], references: [id])

  @@map("ventas")
}

model NivelPremio {
  id                String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre            String
  puntosMinimos     Int     @map("puntos_minimos")
  descripcionPremio String? @map("descripcion_premio")

  @@map("niveles_premio")
}

model Config {
  clave String @id
  valor String

  @@map("config")
}
